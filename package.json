{
  "name": "smart_finance",
  "version": "1.0.0",
  "description": "Smart Finance project with Node.js, TypeScript, Baileys, and Prisma",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "seed": "tsx src/prisma/seed.ts",
    "seed:fresh": "tsx src/prisma/seed.ts --fresh",
    "dashboard": "tsx src/server/dashboard.ts",
    "test": "tsx src/handlers/parser.test.ts && tsx src/prisma/finance/finance.test.ts",
    "typecheck": "tsc --noEmit",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@notionhq/client": "^5.27.1",
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "@prisma/orm-postgres": "8.0.0-rc.16",
    "@whiskeysockets/baileys": "^6.7.18",
    "alchemy": "2.0.0-beta.78",
    "dotenv": "^18.0.9",
    "googleapis": "^187.0.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "8.0.0-rc.21",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@vitejs/devtools": "0.7.6"
  }
}
